{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm ls *)",
      "Bash(npm audit)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(bundle install)",
      "Bash(bundle exec *)",
      "Bash(fastlane *)",
      "Bash(flutter pub *)",
      "Bash(flutter test)",
      "Bash(flutter analyze)",
      "Bash(dart run *)",
      "Bash(rbenv local)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(pwd)",
      "Bash(which *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "./.claude/statusline.sh"
  },
  "hooks": {
    "SessionStart": [{
      "matcher": ".*",
      "hooks": [{
        "type": "command",
        "command": "./.claude/hooks/session-start.sh"
      }]
    }],
    "UserPromptSubmit": [{
      "matcher": ".*",
      "hooks": [{
        "type": "command",
        "command": "./.claude/validate-config.sh",
        "statusMessage": "Validating Claude config portability..."
      }]
    }],
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "./.claude/hooks/block-destructive-commands.sh"
        },
        {
          "type": "command",
          "command": "./.claude/hooks/check-coauthor.sh"
        },
        {
          "type": "command",
          "command": "./.claude/hooks/check-python-env.sh"
        },
        {
          "type": "command",
          "command": "./.claude/hooks/check-submodule-ai.sh"
        },
        {
          "type": "command",
          "command": "./.claude/hooks/check-docs-sync.sh"
        },
        {
          "type": "command",
          "command": "./.claude/hooks/check-feature-map.sh"
        }
      ]
    }],
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "./.claude/hooks/format-code.sh"
      }]
    }]
  }
}

